# ============================================================
# OrçaAI — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
#
# IMPORTANTE: NUNCA exponha chaves secretas no frontend.
# Tudo que começa com NEXT_PUBLIC_ fica visível no navegador.
# ============================================================

# --- Supabase (banco + autenticação + storage) ---
# Se estas duas variáveis estiverem vazias, o OrçaAI roda em
# "modo demonstração" (dados salvos no navegador) — ideal para
# testar o fluxo completo sem configurar nada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (IA: interpretação de pedidos) ---
# Usada APENAS no servidor (API routes). Se vazia, o OrçaAI usa
# o interpretador local (baseado em dados do próprio negócio),
# que nunca inventa preços.
OPENAI_API_KEY=

# --- Site (links compartilháveis / webhooks) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago (assinaturas — opcional no MVP) ---
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
