# ============================================================
# OrçaAI — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
#
# IMPORTANTE: NUNCA exponha chaves secretas no frontend.
# Tudo que começa com NEXT_PUBLIC_ fica visível no navegador.
# ============================================================

# --- Supabase (banco + autenticação + storage) ---
# Se estas duas variáveis estiverem vazias, o OrçaAI roda em
# "modo demonstração" (dados salvos no navegador) — ideal para
# testar o fluxo completo sem configurar nada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (IA: interpretação de pedidos) ---
# Usada APENAS no servidor (API routes). Se vazia, o OrçaAI usa
# o interpretador local (baseado em dados do próprio negócio),
# que nunca inventa preços.
OPENAI_API_KEY=

# --- Site (links compartilháveis / webhooks) ---
# Pode ficar VAZIO — o app usa um fallback seguro. Em produção use o domínio
# real (ex.: https://orcaai.vercel.app) para links de WhatsApp/pagamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago ---
# Assinaturas do próprio app (planos Pro/Business)
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# GATEWAY de pagamento dos orçamentos (Mercado Pago Split/Marketplace):
# o vendedor conecta a conta dele (OAuth) e o cliente paga pelo link.
# Comissão: 2% no plano Grátis, 0% no Pro/Business.
# Client ID + Client SECRET da aplicação Marketplace (NUNCA usar o
# MERCADO_PAGO_ACCESS_TOKEN como secret — ele é da conta dona do app).
MERCADO_PAGO_MARKETPLACE_CLIENT_ID=
MERCADO_PAGO_MARKETPLACE_CLIENT_SECRET=
# (opcional) Chave service role do Supabase — usada SÓ em rotas de servidor
# para o webhook confirmar pagamentos do split com o token do vendedor.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Business API (Meta Cloud API) ---
# Desativa o envio pelo link wa.me e passa a enviar pela API oficial.
# Veja o guia em: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Suporte (aba "Suporte" do painel) ---
# E-mail exibido para contato (padrão: suporte@orcaai.com.br)
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@orcaai.com.br
# Número com DDD para WhatsApp do suporte (opcional — habilita o botão de WhatsApp)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# URL externa de uma central de suporte própria (opcional — mostra botão "Abrir central")
NEXT_PUBLIC_SUPPORT_URL=
